# =============================================================================
# NodeDog — агент на ноде, вариант в контейнере.
# Установить в /opt/nodedog-agent/.env рядом с docker-compose.yml
#
# Файл читают двое, и это важно понимать при правке:
#   AGENT_*    — сам docker compose: из чего собирать контейнер;
#   NODEDOG_*  — агент внутри контейнера: как ему работать.
#
# После правки:
#     cd /opt/nodedog-agent && docker compose up -d
# =============================================================================

# --- Контейнер ---------------------------------------------------------------
# Версия образа. Пинуется явно, без latest: `docker compose pull` не
# должен однажды притащить на боевую ноду то, чего никто не проверял.
#
# Здесь обязана стоять уже опубликованная версия — список в разделе
# Packages репозитория проекта. Тег, которого нет, даёт `manifest
# unknown` не при установке, а на первом запуске контейнера; установщик
# поэтому тянет образ сам и проверяет это сразу.
AGENT_IMAGE_TAG=1.0.1

# GID группы, которой принадлежит журнал Xray. Контейнер работает не от
# root, и это единственный способ дать ему доступ на чтение.
#
# Обычно это группа adm (GID 4 в Debian и Ubuntu) — её же проставляет
# logrotate при ротации, поэтому доступ переживает смену файла.
# Подставляется установщиком; проверить вручную:
#     stat -c '%g %G' /var/log/remnanode
AGENT_GID=4

# Каталог журнала Xray на хосте и имя файла в нём. Монтируется в
# контейнер под тем же путём и строго на чтение.
#
# Разделены не для красоты: из этих двух значений compose собирает и
# точку монтирования, и NODEDOG_LOG_PATH для агента. Задай их порознь —
# они однажды разойдутся, и агент уйдёт ждать файл, которого в
# контейнере нет.
AGENT_LOG_DIR=/var/log/remnanode
AGENT_LOG_FILE=access.log

# Каталог хоста, чей раздел панель показывает как «диск сервера» и по
# которому срабатывает тревога «диск заполнен». Монтируется на чтение,
# агент делает по нему единственный вызов statfs.
#
# По умолчанию корень — тот же раздел, что видит systemd-вариант агента.
# Каталог журнала сюда ставить не нужно: место под журнал уже меряется
# отдельной метрикой, и два одинаковых числа означали бы, что корневой
# раздел не отслеживает никто.
AGENT_DISK_DIR=/

# --- Обязательное ------------------------------------------------------------
# Адрес панели со схемой, без слэша на конце. Только https://: батч содержит
# идентификаторы пользователей вместе с их адресами и посещёнными доменами,
# и по открытому каналу всё это видно посреднику. Для отладочного стенда
# послабление даёт NODEDOG_ALLOW_INSECURE=1 (смотри в конце файла).
NODEDOG_PANEL_URL=https://nodedog.example.com

# UUID ноды и токен агента. Оба выдаются панелью при создании ноды
# в разделе «Ноды». Токен показывается ОДИН РАЗ, сразу после сохранения —
# если потеряли, перевыпустите его действием «Перевыпустить токен»
# в админке (старый перестанет работать немедленно).
NODEDOG_NODE_UUID=
NODEDOG_TOKEN=

# --- Журнал Xray -------------------------------------------------------------
# NODEDOG_LOG_PATH здесь нет намеренно: путь собирается в compose-файле
# из AGENT_LOG_DIR и AGENT_LOG_FILE выше, чтобы он не мог разойтись с
# тем, что смонтировано в контейнер.
#
# Самого файла на новой ноде обычно нет: access-лог включается в ПАНЕЛИ
# REMNAWAVE, в конфигурации Xray для этой ноды, а каталог пробрасывается
# томом в docker-compose.yml ноды. Подробности — в docs/install.md.

# Регулярное выражение разбора строки. Пусто — встроенное, понимающее
# все распространённые варианты формата Xray.
#
# Меняйте, только если панель сообщила, что агент перестал понимать
# журнал. Обязательные именованные группы: src, dst. Полезные:
# ts, srcport, action, proto, dstport, inbound, outbound, email.
# Проверить новое выражение до перезапуска контейнера:
#     docker compose run --rm agent --dry-run
NODEDOG_LOG_REGEX=

# Часовой пояс, в котором Xray пишет метки времени.
#
# В контейнере задавать ОБЯЗАТЕЛЬНО. Пустое значение означает пояс
# системы, а система внутри контейнера живёт по UTC независимо от
# настроек хоста — и вся статистика уедет на несколько часов, ничем
# себя не выдав. Значение — как на ноде: `timedatectl show -p Timezone`.
NODEDOG_LOG_TIMEZONE=Europe/Moscow

# --- Окно агрегации ----------------------------------------------------------
# Окно схлопывания в секундах. Больше окно — сильнее сжатие и выше
# задержка появления данных в панели.
NODEDOG_WINDOW_SECONDS=30

# Как часто снимать метрики сервера.
NODEDOG_METRICS_SECONDS=60

# Потолок числа потоков в окне. ОБЯЗАН совпадать с INGEST_MAX_FLOWS_PER_BATCH
# панели: батч сверх её лимита будет отвергнут целиком — и данные пропадут
# ровно тогда, когда нужны, в момент сканирования сетей.
NODEDOG_MAX_KEYS=50000

# --- Очередь на диске --------------------------------------------------------
# Пути внутри контейнера; наружу вынесены томом state, поэтому переживают
# и перезапуск, и обновление образа.
NODEDOG_STATE_PATH=/var/lib/nodedog/state.json
NODEDOG_SPOOL_DIR=/var/lib/nodedog/spool

# Потолок очереди неотправленных батчей. По достижении агент удаляет
# самые старые: место на ноде дороже полноты статистики.
NODEDOG_SPOOL_MAX_BYTES=268435456

# --- Прочее ------------------------------------------------------------------
NODEDOG_TIMEOUT_SECONDS=30
NODEDOG_LOG_LEVEL=info

# Разрешает http:// в адресе панели. Только для отладочного стенда:
# по открытому каналу уходят идентификаторы пользователей вместе
# с их адресами и посещёнными доменами.
NODEDOG_ALLOW_INSECURE=0
