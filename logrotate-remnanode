# Шаблон ротации журналов Xray на ноде.
#
# Ставится установщиком агента в /etc/logrotate.d/remnanode, если ротация
# ещё не настроена. Без неё access.log растёт неограниченно и рано или
# поздно заполняет раздел — это останавливает и Xray, и агента разом.
#
# Файл — именно шаблон: @LOG_PATTERN@, @CREATE@ и @SU@ подставляет
# install_logrotate из lib/log-access.sh. Группу подставлять обязательно,
# а не прошивать: доступ агенту выдаётся через группу каталога журнала,
# и она у разных нод разная. Расхождение проявляется только через сутки —
# после первой ротации файл достаётся группе, которой у агента нет, и
# агент замолкает без единой ошибки с обеих сторон.
#
# Ставя конфиг руками, замените заглушки на свои значения, например:
#   @LOG_PATTERN@ → /var/log/remnanode/*.log
#   @CREATE@      → create 0640 root adm
#   @SU@          → su root adm
#
# NodeDog журнал не ротирует и не усекает сам: файл читают и другие
# (встроенный Torrent Blocker Remnawave, например), и вмешательство
# агента сломало бы им работу. Ротация — задача системы.

@LOG_PATTERN@ {
    daily
    rotate 7
    # Сжимаем не сразу: агент дочитывает хвост предыдущего файла по
    # открытому дескриптору, и сжатие прямо в момент ротации отняло бы
    # у него эту возможность.
    compress
    delaycompress
    missingok
    notifempty
    # Переименование, а не copytruncate: агент распознаёт смену инода
    # и корректно дочитывает хвост старого файла. copytruncate тоже
    # поддерживается, но при нём есть окно, в котором записанные строки
    # теряются между копированием и обнулением — не по вине агента.
    #
    # 0640, а не 0644: в журнале лежат идентификаторы пользователей вместе
    # с их адресами, и мировое чтение отдало бы эти данные любому процессу
    # на ноде.
    @CREATE@
    @SU@
}
