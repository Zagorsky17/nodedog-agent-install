# =============================================================================
# NodeDog — агент на ноде. Установить в /etc/nodedog/agent.env
#
# Файл читается systemd при каждом запуске службы. После правки:
#     systemctl restart nodedog-agent
# =============================================================================

# --- Обязательное ------------------------------------------------------------
# Адрес панели со схемой, без слэша на конце. Только https://: батч содержит
# идентификаторы пользователей вместе с их адресами и посещёнными доменами,
# и по открытому каналу всё это видно посреднику. Для отладочного стенда
# послабление даёт NODEDOG_ALLOW_INSECURE=1 (смотри в конце файла).
NODEDOG_PANEL_URL=https://nodedog.example.com

# UUID ноды и токен агента. Оба выдаются панелью при создании ноды
# в разделе «Ноды». Токен показывается ОДИН РАЗ, сразу после сохранения —
# если потеряли, перевыпустите его действием «Перевыпустить токен»
# в админке (старый перестанет работать немедленно).
NODEDOG_NODE_UUID=
NODEDOG_TOKEN=

# --- Журнал Xray -------------------------------------------------------------
# Путь к журналу доступа. Значение по умолчанию совпадает с тем, что
# монтирует штатный docker-compose ноды Remnawave.
NODEDOG_LOG_PATH=/var/log/remnanode/access.log

# Регулярное выражение разбора строки. Пусто — встроенное, понимающее
# все распространённые варианты формата Xray.
#
# Меняйте, только если панель сообщила, что агент перестал понимать
# журнал. Обязательные именованные группы: src, dst. Полезные:
# ts, srcport, action, proto, dstport, inbound, outbound, email.
# Проверить новое выражение до перезапуска службы:
#     nodedog-agent --dry-run
NODEDOG_LOG_REGEX=

# Часовой пояс, в котором Xray пишет метки времени. Пусто — пояс системы.
# Задайте явно, если у контейнера ноды пояс отличается от хостового:
# расхождение сдвинет всю статистику на несколько часов.
NODEDOG_LOG_TIMEZONE=

# --- Метрики -----------------------------------------------------------------
# Раздел, чью занятость показывать как «диск сервера». Пусто или «/» —
# корневой, и на ноде с systemd менять это незачем. Настройка появилась
# ради контейнерного варианта установки: внутри контейнера корень —
# это overlay образа, а не диск ноды.
NODEDOG_DISK_PATH=/

# --- Окно агрегации ----------------------------------------------------------
# Как часто отправлять данные, секунды. Меньше — свежее данные, но больше
# запросов к панели; больше — крупнее батчи и выше задержка тревог.
NODEDOG_WINDOW_SECONDS=30

# Как часто снимать метрики сервера, секунды.
NODEDOG_METRICS_SECONDS=60

# Потолок числа уникальных потоков в одном окне. Защита памяти ноды:
# при сканировании сетей число назначений растёт без предела. По
# достижении лимита окно закрывается досрочно, а панель получает
# отметку об усечении — потеря данных не проходит молча.
#
# Значение обязано совпадать с INGEST_MAX_FLOWS_PER_BATCH панели и не может
# его превышать: агент закрывает окно ровно по этому числу, и батч сверх
# панельного лимита был бы отвергнут целиком — данные пропали бы именно
# в момент сканирования. Агент проверяет это на старте и не запустится.
NODEDOG_MAX_KEYS=50000

# --- Очередь на диске --------------------------------------------------------
# Куда складывать батчи, пока панель недоступна.
NODEDOG_SPOOL_DIR=/var/lib/nodedog/spool
# Потолок очереди в байтах (по умолчанию 256 МБ). При переполнении
# удаляются самые старые батчи: свежие данные ценнее, а старые всё
# равно не пройдут проверку свежести на стороне панели.
NODEDOG_SPOOL_MAX_BYTES=268435456

# Где хранить позицию чтения журнала. Благодаря ей перезапуск агента
# не приводит ни к потере строк, ни к их повторной отправке.
NODEDOG_STATE_PATH=/var/lib/nodedog/state.json

# --- Прочее ------------------------------------------------------------------
# Таймаут запроса к панели, секунды.
NODEDOG_TIMEOUT_SECONDS=30
# debug | info | warn | error
NODEDOG_LOG_LEVEL=info

# Разрешить http:// в NODEDOG_PANEL_URL. Только для отладочного стенда:
# по открытому каналу уходят персональные данные пользователей ноды, а
# ответ панели агент никак не аутентифицирует.
NODEDOG_ALLOW_INSECURE=0
